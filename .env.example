# ─── AIVO Learning SaaS — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in the values.
# All variables use ${VAR:-default} in docker-compose.dev.yml so the stack
# boots without a .env file (services fail gracefully for missing secrets).

# ─── JWT (RS256 Keypair) ─────────────────────────────────────────────────────
# Generate with: scripts/dev-up.sh (auto-generates if missing)
# Or manually:
#   openssl genpkey -algorithm RSA -out jwt_private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ─── Identity Service ───────────────────────────────────────────────────────
AUTH_SECRET=change-me-to-a-random-32-char-secret
APP_URL=http://localhost:5000

# Comma-separated list of allowed CORS origins (overrides APP_URL default)
# Example: CORS_ORIGINS=http://localhost:3000,https://app.aivolearning.com
CORS_ORIGINS=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mobile (Expo) Google sign-in client id — baked into the build at EAS time.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Apple OAuth (optional)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ─── Web App ─────────────────────────────────────────────────────────────────
# Server-side URL used by Next.js rewrites to proxy API requests to identity-svc.
# Not exposed to the browser. Defaults to http://localhost:3001.
BACKEND_URL=http://localhost:3001

# ─── Web App (web-v2) — PRODUCTION-REQUIRED ──────────────────────────────────
# apps/web-v2/lib/env.ts validates these at runtime startup. In production the
# app fails fast if they are unset/dev values. Dev defaults shown after `=`.
#
# Auth: "mock" is dev-only and REFUSED in production. Use a real provider.
# On the real-auth pilot path, web-v2 login + session round-trip to identity-svc,
# so IDENTITY_SVC_URL (below) is REQUIRED in production. District-pilot e2e uses
# AUTH_MODE=custom + IDENTITY_SVC_URL=http://identity-svc:3001 (see
# docker-compose.e2e.yml `pilot` profile).
AUTH_MODE=mock                       # prod: clerk | authjs | custom
# Persistence selector. "memory" is the process-local Map store — data is lost
# on restart and not shared across replicas. REFUSED in production; set this
# (and any AIVO_PERSISTENCE_* override) to "postgres" for a real pilot.
AIVO_PERSISTENCE=memory              # prod: postgres (required)
# AI provider: "mock" returns fake tutoring/output and is REFUSED in production.
AI_PROVIDER=mock                     # prod: anthropic | openai | google
# Text-to-speech. "openai" calls OpenAI /v1/audio/speech (needs OPENAI_API_KEY)
# and returns a base64 data URL. Mock audio is restricted to development.
TTS_PROVIDER=mock                    # prod: openai | production
# Speech evaluation mode (services/speech-eval-svc). Production requires live
# mode plus a configured provider and refuses to fabricate scores.
SPEECH_EVAL_MODE=mock                # prod: live
# Session signing secret (>=32 chars; the dev placeholder is refused in prod).
SESSION_SECRET=dev-session-secret-please-change-me
# Stable key for Next.js encrypted Server Actions. WITHOUT a stable value,
# login/invite Server Actions 404 (UnrecognizedActionError) across replicas
# and redeploys. Generate: `openssl rand -base64 32`.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Public base URL of the deployed web app (used for absolute links/redirects).
NEXT_PUBLIC_APP_URL=http://localhost:5000
# Real Postgres is required in production. REDIS_URL is required by
# apps/web-v2/lib/env.ts in production (rate-limiting / shared caches). Note:
# the identity-svc OIDC grant store is Postgres-backed (migration 0051), so it
# no longer depends on Redis for multi-replica correctness.
DATABASE_URL=
REDIS_URL=

# ─── Service URLs ──────────────────────────────────────────────────────────
# Each *_SVC_URL is the base URL of the named backend (no trailing slash, no
# /api path — health/route paths are appended by callers).
#
# REQUIRED IN PRODUCTION for: status-page-svc (it builds its health-check map
# from these), tutor-svc (AI_SVC_URL, BRAIN_SVC_URL, LEARNING_SVC_URL), and
# the assessment / family / identity services that fan out to comms-svc.
# Boot will throw if any required URL is missing in production. In dev the
# localhost defaults below let the local workflow run unchanged.
IDENTITY_SVC_URL=http://localhost:3001
BRAIN_SVC_URL=http://localhost:3002
ASSESSMENT_SVC_URL=http://localhost:3003
AI_SVC_URL=http://localhost:3004
LEARNING_SVC_URL=http://localhost:3005
TUTOR_SVC_URL=http://localhost:3006
FAMILY_SVC_URL=http://localhost:3007
ENGAGEMENT_SVC_URL=http://localhost:3008
BILLING_SVC_URL=http://localhost:3009
COMMS_SVC_URL=http://localhost:3010
I18N_SVC_URL=http://localhost:3011
INTEGRATION_SVC_URL=http://localhost:3012
ADMIN_SVC_URL=http://localhost:3013
STATUS_PAGE_SVC_URL=http://localhost:3014
RESEARCH_SVC_URL=http://localhost:3015

# Canonical standalone admin login surfaces used by identity-svc when a user
# signs in on the wrong host.
WEB_ADMIN_LOGIN_URL=https://admin.aivolearning.com/login
WEB_DISTRICT_LOGIN_URL=https://district.aivolearning.com/login
ADMIN_APP_URL=https://admin.aivolearning.com
DISTRICT_APP_URL=https://district.aivolearning.com

# ─── WebAuthn / passkeys ───────────────────────────────────────────────────
# Comma-separated list of allowed origins for the WebAuthn relying party.
# REQUIRED IN PRODUCTION if the site is served from anything other than the
# default aivolearning.com apex + the *.aivolearning.com subdomains baked in
# to identity-svc. In dev this is empty and the request origin is used.
WEBAUTHN_ORIGINS=
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=

# ─── Internal service-to-service auth ──────────────────────────────────────
# Shared secret used for service-to-service calls (brain-svc -> learning-svc,
# tutor-svc -> learning-svc, status-page-svc -> comms-svc, etc). Senders
# attach it via the `x-service-token` header; receivers validate it in their
# global auth hook.
#
# REQUIRED IN PRODUCTION — learning-svc, tutor-svc, status-page-svc, and
# curriculum-svc all throw at boot if it is missing. In dev a known fallback
# string is used so local hacking is unblocked.
#
# curriculum-svc: accepts EITHER this service token (X-Service-Token) OR a
# real RS256 user JWT verified against JWT_PUBLIC_KEY (above). It fails closed
# at boot in production unless at least one of the two is configured.
INTERNAL_SERVICE_TOKEN=

# Service-to-service secret for the platform-admin "Provision pilot" flow:
# identity-svc (POST /api/admin/pilots) → billing-svc
# (POST /api/billing/internal/pilots/provision, sent as x-service-token; falls
# back to INTERNAL_SERVICE_TOKEN above) and → comms-svc (first-admin invite,
# sent as x-internal-key). Set the same value on identity-svc, billing-svc, and
# comms-svc. Dev defaults to "aivo-internal-dev-key" when unset.
INTERNAL_SERVICE_KEY=

# Shared secret between tutor-svc and ai-svc for AI gateway calls.
# REQUIRED IN PRODUCTION — tutor-svc throws at boot if missing.
INTERNAL_AI_TOKEN=

# ─── IEP AI draft wiring (assessment-svc → ai-svc) ──────────────────────────
# assessment-svc fans out to ai-svc POST /api/ai/iep/draft to synthesise an IEP
# draft from the parent assessment + learning profile, then persists it as an
# `authored` iep_profiles row (lifecycle: ai_draft). Both keys are REQUIRED in
# production for assessment-svc; boot fails closed if AI_SVC_URL is unset there.
#   AI_SVC_URL            already defined above (default http://localhost:3004)
#   INTERNAL_AI_TOKEN     already defined above (shared with tutor-svc → ai-svc)
# Timeout (ms) for the assessment-svc → ai-svc draft call. Draft generation is
# user-initiated and synchronous in the teacher UI; keep it tight and surface a
# retry rather than hanging the request.
AI_IEP_DRAFT_TIMEOUT_MS=20000

# ─── IEP progress sync worker (brain-svc image, cron entrypoint) ────────────
# Cadence for mapping learner mastery deltas → iep_goals.current_progress.
# Cron form (UTC). Default: every 15 min. Empty disables the worker.
IEP_PROGRESS_SYNC_CRON=*/15 * * * *
# Minimum mastery delta (0..1) required before we write a new progress value +
# append an iep_progress_notes row. Prevents note spam from noise.
IEP_PROGRESS_SYNC_MIN_DELTA=0.05
# Optional users(id) used as the author of the parent-visible progress note.
# iep_progress_notes.author_id is NOT NULL with an FK to users, so when this is
# unset the worker still writes current_progress but skips the note.
IEP_PROGRESS_SYNC_AUTHOR_ID=

# ─── Email (Oonrumail — legacy, kept for callers that haven't migrated) ─────
# Used by identity-svc and comms-svc
OONRUMAIL_API_KEY=
OONRUMAIL_BASE_URL=https://api.oonrumail.com/v1

# ─── Email (Postmark — primary transactional provider) ──────────────────────
# comms-svc sends through Postmark by default. Leave POSTMARK_API_TOKEN
# unset in dev to fall back to "logged only" / "dev_mode" responses.
POSTMARK_API_TOKEN=
FROM_EMAIL=noreply@aivolearning.com
FROM_NAME=AIVO Learning
# Shared secret used to verify Postmark's webhook bodies. Required to
# reconcile bounces/spam complaints into email_outbox.
POSTMARK_WEBHOOK_SECRET=
# Optional alternative providers, accepted by the same webhook ingester.
MAILGUN_WEBHOOK_SIGNING_KEY=
AIVO_SNS_WEBHOOK_SECRET=

# ─── CRM Lead Webhook (admin-svc, optional) ─────────────────────────────────
# When CRM_WEBHOOK_URL is set, admin-svc POSTs every new lead to it with an
# HMAC-SHA256 signature (header `x-aivo-signature`) over the JSON body, so the
# CRM (Salesforce/HubSpot/Pipedrive/…) can verify authenticity. Delivery is
# fail-soft: a CRM outage never blocks lead capture. When unset, lead capture
# is unchanged and nothing is delivered.
# REQUIRED IN PRODUCTION if CRM_WEBHOOK_URL is set: CRM_WEBHOOK_SECRET must
# also be set, or delivery is skipped (and logged).
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# ─── Email Outbox (durable delivery for comms-svc) ──────────────────────────
# Every sendEmail() call persists to the email_outbox table; a drain
# worker (one leader across the fleet) actually hands the message to the
# provider, retries with exponential backoff, and moves permanent failures
# to dead_letter. Set EMAIL_OUTBOX_DISABLED=1 to bypass the queue entirely
# (writes go straight to Postmark — only use this for one-off migrations).
# Set EMAIL_OUTBOX_WORKER_DISABLED=1 to keep queueing but stop draining
# (useful while running maintenance on the queue table).
EMAIL_OUTBOX_DISABLED=
EMAIL_OUTBOX_WORKER_DISABLED=
EMAIL_OUTBOX_TICK_MS=15000
EMAIL_OUTBOX_BATCH_SIZE=50

# ─── AI Service — LLM Provider Keys ─────────────────────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# ─── AI Service — Model Routing ─────────────────────────────────────────────
REASONING_MODEL=anthropic/claude-sonnet-4-20250514
REASONING_FALLBACK_MODEL=google/gemini-2.0-flash
SMART_MODEL=anthropic/claude-sonnet-4-20250514
SMART_FALLBACK_MODEL=google/gemini-2.0-flash
FAST_MODEL=anthropic/claude-sonnet-4-20250514
FAST_FALLBACK_MODEL=google/gemini-2.0-flash
SELF_HOSTED_MODEL=ollama/llama3
VISION_MODEL=google/gemini-2.0-flash
VISION_FALLBACK_MODEL=openai/gpt-4o
IEP_PARSE_MODEL=anthropic/claude-sonnet-4-20250514
EMBEDDING_MODEL=text-embedding-3-small
TOKEN_QUOTA_SOFT_LIMIT_PERCENT=80

# ─── AI Service — Langfuse Observability (optional) ─────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Billing Service — Stripe ───────────────────────────────────────────────
# Get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Stripe Price IDs — created by: npx tsx scripts/stripe-setup.ts
STRIPE_PRICE_STARTER=
STRIPE_PRICE_FAMILY=
STRIPE_PRICE_PREMIUM=

# Plan price ID used by billing-svc Checkout. STRIPE_PRICE_FAMILY maps to
# the `family` plan ($39.99/mo per child; subscription quantity = number of
# children). Enterprise is contact-sales and does NOT use Checkout, so it
# has no price ID. There is no free tier.
#
# Provision the Product and Price idempotently with:
#   STRIPE_SECRET_KEY=sk_test_... npx tsx scripts/stripe-setup.ts

# Where Stripe redirects the parent after Checkout success/cancel, and
# the Customer Portal return URL. Use absolute https URLs in production.
APP_BILLING_SUCCESS_URL=
APP_BILLING_CANCEL_URL=
STRIPE_CUSTOMER_PORTAL_RETURN_URL=

# Stripe Add-on Tutor Price IDs (legacy; not used after the unified
# tutor add-on price above)
STRIPE_PRICE_TUTOR_MATH=
STRIPE_PRICE_TUTOR_ELA=
STRIPE_PRICE_TUTOR_SCIENCE=
STRIPE_PRICE_TUTOR_HISTORY=
STRIPE_PRICE_TUTOR_CODING=
STRIPE_PRICE_TUTOR_SEL=
STRIPE_PRICE_TUTOR_SPEECH=
STRIPE_PRICE_TUTOR_BUNDLE=

# Local dev escape hatch: when set to "true", tutor-svc and learning-svc
# skip the entitlement gate so the stage runtime can be exercised without
# Stripe wiring. NEVER set this in production.
AIVO_ALLOW_UNGATED_TUTORS=

# Access policy when a subscription is in Stripe `past_due` (the
# automatic invoice retry window). "allow" (default) keeps the learner
# unlocked through dunning; "deny" locks them out the moment the first
# retry fires. Most SaaS billing flows want "allow".
AIVO_PAST_DUE_GRACE_POLICY=allow

# ─── Comms Service — Firebase Cloud Messaging (optional) ────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Sprint 12.7 — full FCM HTTP v1 + APNs token-auth wiring. Blank when
# push is not yet configured for the environment; production must set
# the relevant set (FCM_* for Android/Web, APNS_* for iOS) before push
# notifications take effect.
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
APNS_HOST=

# Webhook signature secrets (Postmark, Mailgun, SES-via-SNS). Required in
# production when the corresponding email provider is enabled.
POSTMARK_WEBHOOK_SECRET=
MAILGUN_WEBHOOK_SIGNING_KEY=
AIVO_SNS_WEBHOOK_SECRET=

# ─── Comms Service — Web Push VAPID (optional) ──────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=support@aivolearning.com

# ─── Integrations Service — Clever SSO (optional) ───────────────────────────
CLEVER_CLIENT_ID=
CLEVER_CLIENT_SECRET=
CLEVER_REDIRECT_URI=http://localhost:3010/integrations/clever/callback

# ─── Integrations Service — ClassLink SSO (optional) ────────────────────────
CLASSLINK_CLIENT_ID=
CLASSLINK_CLIENT_SECRET=
CLASSLINK_REDIRECT_URI=http://localhost:3010/integrations/classlink/callback

# ─── Integrations Service — LTI 1.3 (optional) ─────────────────────────────
LTI_PRIVATE_KEY=
LTI_PUBLIC_KEY=
LTI_KID=aivo-lti-key-1

# ─── AWS S3 (optional — family-svc exports, integrations-svc imports) ───────
AWS_S3_BUCKET=aivo-integrations
AWS_REGION=us-east-1
S3_BUCKET=aivo-family-exports
S3_REGION=us-east-1

# ─── Enterprise Admin Hardening — Feature Flags (Sprint 0) ──────────────────
# All flags default OFF. Sprints 1-11 read these to gate rollout. Set to
# "true"/"1"/"yes"/"on" to enable; any other value (or unset) keeps the
# capability disabled. Toggling at runtime requires a service restart.
#
# Sprint 2 — Require WebAuthn / phishing-resistant MFA for admin logins.
ADMIN_ENTERPRISE_STRONG_MFA=false
# Sprint 3 — Require fresh re-auth before high-risk admin actions.
ADMIN_ENTERPRISE_STEP_UP_AUTH=false
# Sprint 6 — Enable SAML SSO + SCIM provisioning for districts.
ADMIN_ENTERPRISE_DISTRICT_SSO=false
# Sprint 4 — Append-only / hash-chained audit log entries.
ADMIN_ENTERPRISE_AUDIT_IMMUTABLE=false
# Sprint 5 — Idle timeout (seconds) for admin sessions; 0 disables.
ADMIN_ENTERPRISE_ADMIN_SESSION_IDLE=0

# ─── Ops Alerts (on-call paging) ───────────────────────────────────────────
# Base URL of alerts-proxy-svc. Producer services route on-call pages here.
ALERTS_PROXY_URL=http://localhost:3016
# alerts-proxy channel credentials. In prod, ALL THREE must be set or the
# deploy gate (.github/workflows/alerts-proxy-deploy-gate.yml) fails the
# rollout. The values themselves never appear in /api/alerts/health.
OPS_ALERTS_SLACK_WEBHOOK_URL=
OPS_ALERTS_PAGERDUTY_ROUTING_KEY=
OPS_ALERTS_OPSGENIE_API_KEY=
# Per-service durability for queued envelopes that the proxy can't accept.
# Choose one of:
#   OPS_ALERTS_OUTBOX_PG_TABLE   — persist to Postgres (requires pgOutboxClient
#                                  to be wired in code; otherwise the service
#                                  logs a warning at startup and falls back).
#   OPS_ALERTS_OUTBOX_FILE_PATH  — JSONL file outbox (use a writable volume).
#   neither                      — in-memory only (lost on restart).
# Set OPS_ALERTS_OUTBOX_PG_STRICT=1 to make the misconfig a startup error.
OPS_ALERTS_OUTBOX_PG_TABLE=
OPS_ALERTS_OUTBOX_FILE_PATH=
OPS_ALERTS_OUTBOX_PG_STRICT=
OPS_ALERTS_AUTOFLUSH_MS=30000
OPS_ALERTS_SHUTDOWN_WINDOW_MS=5000
# status-page-svc fans out to these to render queue depth tiles. Format:
# "service=base_url,service=base_url". When unset, the status page defaults
# to scraping every service that's wired with bootstrapOpsAlerts (admin,
# billing, comms, assessment, learning, tutor, family, engagement, identity,
# integrations, i18n, research) using their existing *_SVC_URL.
OPS_ALERT_OUTBOX_SOURCES=

# ---------------------------------------------------------------------------
# Enterprise feature flags — also defined in
# infra/k8s/base/enterprise/feature-flags-configmap.yaml. Keep the two in
# sync. Each flag is read by callers via process.env at request time and
# falls back to legacy behavior when off.
# ---------------------------------------------------------------------------
AIVO_FEATURE_PROBLEM_SESSION_LEDGER=false
AIVO_FEATURE_TUTOR_SURFACE_PROTOCOL=false
AIVO_FEATURE_PROFILE_RECOMMENDATIONS_V2=false
AIVO_FEATURE_DISTRICT_ENTERPRISE_MODE=false
# Sprint H — SIS rostering + LTI 1.3 launch validation.
AIVO_FEATURE_SIS_SYNC=true
AIVO_FEATURE_LTI_13=true
# Sprint G — data governance + responsible-AI guardrails.
AIVO_FEATURE_DATA_GOVERNANCE_CENTER=true
AIVO_FEATURE_RESPONSIBLE_AI_GUARDRAILS=true
# Subject-brain enrichment across learning-svc, tutor-svc/chat,
# tutor-svc/homework, and ai-svc advanced generators. ON enables the
# five fully-wired subject brains (math, ELA, science, world languages,
# life skills) plus social-emotional / executive-function / social-studies.
# All 16 subject tutors use the shared agentic runtime; this flag enables
# subject-brain enrichment where a specialized reasoner is available.
AIVO_FEATURE_ADVANCED_CONTENT_GENERATORS=true
AIVO_FEATURE_SELF_REGULATION_HUB=false

# ─── Baseline assessment generation (apps/web-v2) ──────────────────────────
# The learner baseline must be LLM-personalized from the parent assessment —
# and, when on file, the caregiver (co-parent) and teacher assessments + IEP +
# interests + district context — rather than serving the static fallback BANK.
#
# AIVO_FEATURE_BASELINE_LLM defaults ON everywhere (including production); set
# it to "false" as a kill switch to force the deterministic BANK. Every failure
# mode (auth, timeout, too-few questions, no subject mapping) already falls open
# to the BANK, so ON-by-default cannot break baseline creation.
#
# AIVO_FEATURE_BASELINE_DISCOVERY gates the richer per-chapter "Discovery
# Adventure" path; it defaults to whatever AIVO_FEATURE_BASELINE_LLM resolves to.
# IMPORTANT: the web-v2 BFF calls assessment-svc for both paths and authenticates
# with ASSESSMENT_SVC_SERVICE_TOKEN (below). Without a valid token assessment-svc
# returns 401 and the baseline silently falls back to the BANK — so to actually
# get LLM baselines in production you must set BOTH the flag and the token.
AIVO_FEATURE_BASELINE_LLM=true
AIVO_FEATURE_BASELINE_DISCOVERY=true
# Shared secret the web-v2 BFF attaches (as x-service-token) when calling
# assessment-svc's baseline/discovery routes. Must equal assessment-svc's
# INTERNAL_SERVICE_TOKEN (above) — assessment-svc accepts the service bypass
# only when its INTERNAL_SERVICE_TOKEN is set and the header matches. REQUIRED
# in production; also set it locally (to the same value as INTERNAL_SERVICE_TOKEN)
# if you want LLM/Discovery baselines in dev, otherwise the call 401s and the
# baseline falls back to the BANK.
ASSESSMENT_SVC_SERVICE_TOKEN=

# ---------------------------------------------------------------------------
# Sprint F — speech-eval-svc ASR provider.
# ---------------------------------------------------------------------------
# SPEECH_EVAL_MODE=live activates the real ASR path. ASR_PROVIDER picks the
# backend. Provider failures return a retryable 503 without fabricated scores.
SPEECH_EVAL_MODE=mock
ASR_PROVIDER=
OPENAI_API_KEY=
OPENAI_API_BASE_URL=
WHISPER_MODEL=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Speech Buddy encrypted transcript/session recovery. Production requires a
# base64 or raw master key and a durable shared/mounted storage directory.
SPEECH_BUDDY_STT_PROVIDER=mock
SPEECH_BUDDY_TTS_PROVIDER=mock
SPEECH_BUDDY_JUDGE_PROVIDER=stub
SPEECH_BUDDY_TRANSCRIPT_MASTER_KEY=
SPEECH_BUDDY_TRANSCRIPT_DIR=

# SOC 2 evidence WORM storage. The bucket must have S3 Object Lock enabled.
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_REGION=
EVIDENCE_S3_PREFIX=soc2-evidence
EVIDENCE_S3_KMS_KEY_ID=
EVIDENCE_RETENTION_YEARS=7

# ---------------------------------------------------------------------------
# Sprint A — zip→district lookup fallback. NCES seed is the primary
# source (scripts/seed-nces-districts.mjs); the fallback only fires when
# a zip has no NCES match and a provider is configured.
# ---------------------------------------------------------------------------
ZIP_LOOKUP_FALLBACK_PROVIDER=
GEOCODIO_API_KEY=

# ---------------------------------------------------------------------------
# Sprint G + H — service URLs the apps/web-v2 BFF fans out to when the
# matching enterprise flag is on.
# ---------------------------------------------------------------------------
RESPONSIBLE_AI_SVC_URL=http://localhost:3071
DATA_GOVERNANCE_SVC_URL=http://localhost:3072
INTEGRATION_SVC_URL=http://localhost:3060

# Curriculum grounding. ai-svc grounds baseline generation in the
# authoritative curriculum-svc catalogue (jurisdiction-scoped skill anchors
# for the learner's ZIP or country/region + grade band), and brain-svc
# validates LLM-proposed standards against it (ADR 0041). brain-svc,
# ai-svc, and identity-svc all resolve curriculum via CURRICULUM_SVC_URL.
CURRICULUM_SVC_URL=http://localhost:3013
# Grounding is ON BY DEFAULT (Sprint 3). This var is purely an ops kill
# switch: set it to a falsey value (0/false/no/off) to disable. Leave
# unset/blank to keep grounding enabled.
AIVO_FEATURE_CURRICULUM_GROUNDING=

# curriculum-svc persistence (Sprint 4 authoring/CMS write path).
#   snapshot (default) — read-only bundled snapshot; authoring disabled.
#   memory             — in-process mutable store (dev/test).
#   postgres           — durable store backed by the curriculum_* tables
#                        (migration 0067); requires CURRICULUM_DATABASE_URL.
CURRICULUM_PERSISTENCE=snapshot
CURRICULUM_DATABASE_URL=


# ── Observability (Sprint A2) ─────────────────────────────────────────────
# Client+server error tracking. REQUIRED in production (prod:check enforces).
# Web (browser + server; SENTRY_DSN overrides server-side if set):
NEXT_PUBLIC_SENTRY_DSN=
# Mobile (baked at EAS build time):
EXPO_PUBLIC_SENTRY_DSN=
# Release tagging + CI source-map upload (uploads are skipped when unset):
SENTRY_ENVIRONMENT=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# District console origin used by the web-v2 marketing header "For Districts"
# link (rendered as an external <a>, Sprint A3). Defaults to the production
# district app when unset.
NEXT_PUBLIC_DISTRICT_APP_URL=

# ── Creator weekly pre-generation (remediation Sprint 06) ────────────────────
# admin-svc's Sunday-night `creator.weekly-generation` SafeCron calls web-v2's
# internal route to pre-generate each active learner's next lesson. Both vars
# must be set on admin-svc (web-v2 validates the same INTERNAL_SERVICE_TOKEN);
# without them the job fails closed instead of silently skipping.
WEB_V2_INTERNAL_URL=http://localhost:5000
