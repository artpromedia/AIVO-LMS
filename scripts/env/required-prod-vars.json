{
  "$schema": "./required-prod-vars.schema.json",
  "comment": "Sprint 12.7 — vars that MUST be set in production. The production-readiness-check.mjs script consults this manifest. Add new groups when introducing services; keep placeholder patterns in sync with .env.example.",
  "placeholderPatterns": [
    "change-me",
    "replace-me",
    "your-key-here",
    "blank-when-required",
    "dev-session-secret",
    "aivo-dev-cookie-secret",
    "change-me-to-a-random-32-char-secret",
    "TODO",
    "PLACEHOLDER",
    "<insert"
  ],
  "groups": {
    "core": {
      "required": ["AUTH_SECRET", "COOKIE_SECRET", "DATABASE_URL", "APP_URL"],
      "minLength": { "AUTH_SECRET": 32, "COOKIE_SECRET": 32 }
    },
    "identity-svc": {
      "required": [
        "JWT_PRIVATE_KEY",
        "JWT_PUBLIC_KEY",
        "INTERNAL_SERVICE_TOKEN",
        "INTERNAL_AI_TOKEN",
        "WEBAUTHN_RP_ID",
        "WEBAUTHN_ORIGINS"
      ]
    },
    "comms-svc": {
      "required": ["POSTMARK_WEBHOOK_SECRET"],
      "conditional": {
        "OONRUMAIL_API_KEY": "if email delivery enabled",
        "MAILGUN_WEBHOOK_SIGNING_KEY": "if mailgun provider enabled",
        "AIVO_SNS_WEBHOOK_SECRET": "if SES via SNS enabled",
        "FCM_SERVICE_ACCOUNT_JSON": "if FCM push enabled",
        "APNS_KEY_ID": "if APNs push enabled",
        "APNS_TEAM_ID": "if APNs push enabled",
        "APNS_PRIVATE_KEY": "if APNs push enabled",
        "APNS_BUNDLE_ID": "if APNs push enabled"
      }
    },
    "billing-svc": {
      "required": ["STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET"]
    },
    "integration-svc": {
      "required": ["LTI_PRIVATE_KEY", "LTI_PUBLIC_KEY", "LTI_KID"]
    },
    "ops-alerts": {
      "required": [
        "OPS_ALERTS_SLACK_WEBHOOK_URL",
        "OPS_ALERTS_PAGERDUTY_ROUTING_KEY",
        "OPS_ALERTS_OPSGENIE_API_KEY"
      ]
    },
    "secrets": {
      "required": ["SECRETS_PROVIDER"],
      "comment": "SECRETS_PROVIDER selects Vault | aws-secrets-manager | env. The first two require additional creds resolved at runtime by packages/security/src/secrets-client.ts."
    },
    "web-v2": {
      "comment": "Next.js web app runtime invariants. apps/web-v2/lib/env.ts enforces these at process startup; this manifest enforces them at the deploy gate (fail-closed before traffic).",
      "required": [
        "AUTH_MODE",
        "AI_PROVIDER",
        "AIVO_PERSISTENCE",
        "SESSION_SECRET",
        "NEXT_SERVER_ACTIONS_ENCRYPTION_KEY",
        "NEXT_PUBLIC_APP_URL",
        "REDIS_URL",
        "TTS_PROVIDER"
      ],
      "minLength": { "SESSION_SECRET": 32, "NEXT_SERVER_ACTIONS_ENCRYPTION_KEY": 32 },
      "values": {
        "AUTH_MODE": { "notOneOf": ["mock"] },
        "AI_PROVIDER": { "notOneOf": ["mock"] },
        "AIVO_PERSISTENCE": { "equals": "postgres" },
        "TTS_PROVIDER": { "oneOf": ["openai", "production"] }
      },
      "conditional": {
        "ANTHROPIC_API_KEY": "required when AI_PROVIDER=anthropic (lib/ai/anthropic-tutor.ts)",
        "OPENAI_API_KEY": "required when AI_PROVIDER=openai OR TTS_PROVIDER=openai (lib/tts/provider.ts)",
        "GOOGLE_API_KEY": "required when AI_PROVIDER=google"
      }
    },
    "speech-eval-svc": {
      "comment": "Speech evaluation must use a configured live ASR provider in production.",
      "required": ["SPEECH_EVAL_MODE", "ASR_PROVIDER"],
      "values": {
        "SPEECH_EVAL_MODE": { "equals": "live" },
        "ASR_PROVIDER": { "oneOf": ["openai", "openai-whisper", "azure", "azure-speech"] }
      },
      "conditional": {
        "OPENAI_API_KEY": "required when ASR_PROVIDER=openai or openai-whisper",
        "AZURE_SPEECH_KEY": "required when ASR_PROVIDER=azure or azure-speech",
        "AZURE_SPEECH_REGION": "required when ASR_PROVIDER=azure or azure-speech"
      }
    },
    "speech-buddy": {
      "comment": "Speech Buddy must use live STT, TTS, safety judging, encrypted session recovery, and durable shared storage.",
      "required": [
        "SPEECH_BUDDY_STT_PROVIDER",
        "SPEECH_BUDDY_TTS_PROVIDER",
        "SPEECH_BUDDY_JUDGE_PROVIDER",
        "SPEECH_BUDDY_TRANSCRIPT_MASTER_KEY",
        "SPEECH_BUDDY_TRANSCRIPT_DIR",
        "OPENAI_API_KEY"
      ],
      "minLength": { "SPEECH_BUDDY_TRANSCRIPT_MASTER_KEY": 32 },
      "values": {
        "SPEECH_BUDDY_STT_PROVIDER": { "equals": "whisper" },
        "SPEECH_BUDDY_TTS_PROVIDER": { "equals": "openai" },
        "SPEECH_BUDDY_JUDGE_PROVIDER": { "oneOf": ["llm", "moderation", "gateway"] }
      }
    },
    "soc2-evidence": {
      "comment": "SOC 2 evidence bundles must be retained in an S3 Object Lock bucket.",
      "required": ["EVIDENCE_S3_BUCKET", "EVIDENCE_S3_REGION"]
    }
  }
}
