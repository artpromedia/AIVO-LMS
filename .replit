modules = ["nodejs-20", "python-3.12", "web", "bash"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"
packages = ["cargo", "libiconv", "libxcrypt", "nats-server", "openssl", "pkg-config", "postgresql", "rustc"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Brain Service"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Identity Service"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Web App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Marketing Site"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Mockup Sandbox"

[[workflows.workflow]]
name = "Brain Service"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd services/brain-svc && pip install -q -r requirements.txt 2>/dev/null; PYTHONPATH=src python3 -m uvicorn brain_svc.main:app --host 0.0.0.0 --port 3002"
waitForPort = 3002

[[workflows.workflow]]
name = "Identity Service"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && bash scripts/start-services.sh"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Web App"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/web-v2 && exec ./node_modules/.bin/next dev --port 5000 --hostname 0.0.0.0 --turbopack"
waitForPort = 5000

[[workflows.workflow]]
name = "Marketing Site"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start-marketing.sh"
waitForPort = 5173

[[workflows.workflow]]
name = "Mockup Sandbox"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/mockup-sandbox && PORT=8000 BASE_PATH=/mockup-canvas/ exec ./node_modules/.bin/vite --config vite.config.ts --host 0.0.0.0 --port 8000"
waitForPort = 8000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 3002

[[ports]]
localPort = 3003
externalPort = 3003

[[ports]]
localPort = 3004
externalPort = 5173

[[ports]]
localPort = 3005
externalPort = 6000

[[ports]]
localPort = 3006
externalPort = 4200

[[ports]]
localPort = 3007
externalPort = 8099

[[ports]]
localPort = 3008
externalPort = 8080

[[ports]]
localPort = 3009
externalPort = 9000

[[ports]]
localPort = 3010
externalPort = 8008

[[ports]]
localPort = 3011
externalPort = 8081

[[ports]]
localPort = 3012
externalPort = 5000

[[ports]]
localPort = 3013
externalPort = 6800

[[ports]]
localPort = 3014
externalPort = 8000

[[ports]]
localPort = 4222
externalPort = 3003

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 6379
externalPort = 3000
exposeLocalhost = true

[[ports]]
localPort = 8222
externalPort = 3002

[[ports]]
localPort = 5173
externalPort = 5173

