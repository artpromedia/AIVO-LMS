{
  "name": "aivo-ai-learning",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:push": "pnpm --filter @aivo/db db:push",
    "db:seed": "pnpm --filter @aivo/db db:seed",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "i18n:audit:verbose": "node scripts/i18n-audit.mjs --verbose",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "test:enterprise": "vitest run --config tests/integration/vitest.enterprise.config.ts",
    "prod:check": "node scripts/production-readiness-check.mjs",
    "prod:no-demo": "node scripts/no-demo-prod-scan.mjs",
    "prod:surface-contract": "node scripts/surface-contract-scan.mjs",
    "test:production-readiness": "vitest run --config tests/integration/vitest.production-readiness.config.ts tests/integration/production-readiness.test.ts tests/integration/no-demo-prod.test.ts tests/integration/surface-contract-gates.test.ts",
    "api:dump": "node scripts/dump-openapi.mjs",
    "api:generate": "pnpm api:dump && node scripts/generate-api-client.mjs",
    "api:check": "pnpm api:generate && git diff --exit-code -- packages/api-client/openapi packages/api-client/src",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,mdx,yml,yaml,css,scss,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,mdx,yml,yaml,css,scss,html}\"",
    "lint:fleet": "eslint --max-warnings=Infinity \"services/**/*.{ts,tsx,js,mjs,cjs}\" \"packages/db/**/*.{ts,tsx,js,mjs,cjs}\" \"packages/events/**/*.{ts,tsx,js,mjs,cjs}\"",
    "repo:health": "node scripts/repo-health-check.mjs",
    "brand:check": "node scripts/brand-asset-check.mjs",
    "consent:audit": "node scripts/consent-gate-audit.mjs",
    "auth:audit": "node scripts/auth-mode-audit.mjs",
    "curriculum:validate": "node scripts/curriculum-validate.mjs",
    "onboarding:audit": "node scripts/onboarding-audit.mjs",
    "lessonrun:audit": "node scripts/lessonrun-audit.mjs",
    "route:audit": "node scripts/route-audit.mjs",
    "mobile:audit": "node scripts/mobile-unified-audit.mjs"
  },
  "devDependencies": {
    "eas-cli": "^18.6.0",
    "openapi-typescript": "^7.4.4",
    "prettier": "^3.6.2",
    "tsx": "^4.19.4",
    "turbo": "^2.5.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "@types/react": "19.1.4",
      "@types/react-dom": "19.1.5",
      "node-forge@<1.3.2": ">=1.3.2",
      "tar@<7.5.8": ">=7.5.8",
      "minimatch@>=5.0.0 <5.1.8": ">=5.1.8",
      "@xmldom/xmldom@<0.8.13": ">=0.8.13",
      "@xmldom/xmldom": ">=0.8.13",
      "axios@<1.15.2": ">=1.15.2",
      "drizzle-orm@<0.45.2": ">=0.45.2",
      "fastify@>=5.3.2 <5.8.5": ">=5.8.5",
      "fast-xml-builder@<1.1.7": ">=1.1.7",
      "fast-uri@<3.1.2": ">=3.1.2",
      "@babel/plugin-transform-modules-systemjs@>=7.12.0 <7.29.4": ">=7.29.4"
    }
  }
}
