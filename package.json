{
  "name": "aivo-ai-learning",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "storybook:build": "corepack pnpm --filter @aivo/learner-ui storybook:build",
    "db:push": "pnpm --filter @aivo/db db:push",
    "db:seed": "pnpm --filter @aivo/db db:seed",
    "seed:nces": "node scripts/seed-nces-districts.mjs",
    "legacy:drift": "node scripts/legacy-drift-check.mjs",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "i18n:audit:verbose": "node scripts/i18n-audit.mjs --verbose",
    "i18n:untranslated": "node scripts/i18n-untranslated-report.mjs",
    "i18n:untranslated:targeted": "node scripts/i18n-untranslated-report.mjs --namespace=billing,speech_buddy,onboarding,whats_working,lti_admin --max-targeted=0",
    "i18n:untranslated:ratchet": "node scripts/i18n-untranslated-report.mjs --threshold=scripts/i18n-untranslated.baseline.json",
    "i18n:coverage": "node scripts/ci/check-i18n-coverage.mjs",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:extract:gate": "node scripts/i18n-extract.mjs --gate",
    "i18n:extract:baseline": "node scripts/i18n-extract.mjs --update-baseline",
    "check:no-coming-soon": "node scripts/ci/check-no-coming-soon.mjs",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "test:integration:inprocess": "vitest run --config tests/integration/inprocess/vitest.config.ts",
    "test:enterprise": "vitest run --config tests/integration/vitest.enterprise.config.ts",
    "prod:check": "node scripts/production-readiness-check.mjs",
    "prod:no-demo": "node scripts/no-demo-prod-scan.mjs",
    "prod:surface-contract": "node scripts/surface-contract-scan.mjs",
    "test:production-readiness": "vitest run --config tests/integration/vitest.production-readiness.config.ts tests/integration/production-readiness.test.ts tests/integration/no-demo-prod.test.ts tests/integration/surface-contract-gates.test.ts",
    "api:dump": "node scripts/dump-openapi.mjs",
    "api:generate": "pnpm api:dump && node scripts/generate-api-client.mjs",
    "api:check": "pnpm api:generate && git diff --exit-code -- packages/api-client/openapi packages/api-client/src",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,mdx,yml,yaml,css,scss,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,mdx,yml,yaml,css,scss,html}\"",
    "lint:fleet": "eslint --max-warnings=Infinity \"services/**/*.{ts,tsx,js,mjs,cjs}\" \"packages/db/**/*.{ts,tsx,js,mjs,cjs}\" \"packages/events/**/*.{ts,tsx,js,mjs,cjs}\"",
    "repo:health": "node scripts/repo-health-check.mjs",
    "brand:check": "node scripts/brand-asset-check.mjs",
    "consent:audit": "node scripts/consent-gate-audit.mjs",
    "auth:audit": "node scripts/auth-mode-audit.mjs",
    "api:boundary": "node scripts/check-api-boundary.mjs",
    "curriculum:validate": "node scripts/curriculum-validate.mjs",
    "item-bank:import-multimedia-fixtures": "node scripts/item-bank-import-multimedia-fixtures.mjs",
    "curriculum:validate-pack": "tsx scripts/validate-k8-curriculum-pack.ts",
    "item-bank:import": "pnpm --filter @aivo/item-bank item-bank:import",
    "item-bank:validate": "pnpm --filter @aivo/item-bank build && pnpm --filter @aivo/item-bank item-bank:validate",
    "onboarding:audit": "node scripts/onboarding-audit.mjs",
    "lessonrun:audit": "node scripts/lessonrun-audit.mjs",
    "route:audit": "node scripts/route-audit.mjs",
    "shell:audit": "node scripts/single-shell-audit.mjs",
    "mobile:single-listing": "node apps/mobile/scripts/check-single-listing.mjs",
    "well-known:smoke": "node scripts/well-known-links-smoke.mjs",
    "rbac:audit": "node scripts/rbac-matrix-audit.mjs",
    "mobile:audit": "node scripts/mobile-unified-audit.mjs",
    "mobile:role-audit": "node scripts/mobile-role-audit.mjs",
    "ux:parity": "node scripts/ux-parity-check.mjs",
    "a11y:audit": "node scripts/a11y-audit.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "persistence:stubs": "node scripts/check-persistence-stubs.mjs",
    "mobile:parity": "node scripts/web-mobile-parity-check.mjs",
    "mobile:parity:strict": "node scripts/web-mobile-parity-check.mjs --strict",
    "mobile:parity:md": "node scripts/web-mobile-parity-check.mjs --markdown > docs/mobile-parity.md",
    "marketing:audit": "node scripts/marketing-audit.mjs",
    "billing:audit": "node scripts/billing-audit.mjs",
    "rostering:audit": "node scripts/rostering-audit.mjs",
    "comms:audit": "node scripts/comms-audit.mjs",
    "ai-safety:audit": "node scripts/ai-safety-audit.mjs",
    "accessibility:audit": "node scripts/accessibility-audit.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "backend:parity": "node scripts/backend-parity-check.mjs",
    "tutor:parity": "node scripts/tutor-parity-check.mjs",
    "curriculum:coverage": "node scripts/curriculum-coverage-check.mjs",
    "ux:matrix": "node scripts/subject-tutor-ux-check.mjs",
    "green:check": "node scripts/green-check.mjs",
    "ci:doc-vs-gate": "node scripts/ci/doc-vs-gate-consistency.mjs",
    "ci:doc-vs-gate:verify": "node scripts/ci/doc-vs-gate-consistency.mjs --verify"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "eas-cli": "^18.6.0",
    "eslint": "^10.2.0",
    "openapi-typescript": "^7.4.4",
    "prettier": "^3.6.2",
    "tsx": "^4.22.4",
    "turbo": "^2.9.16",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "@types/react": "19.1.4",
      "@types/react-dom": "19.1.5",
      "node-forge@<1.3.2": ">=1.3.2",
      "tar@<7.5.8": ">=7.5.8",
      "minimatch@>=5.0.0 <5.1.8": ">=5.1.8",
      "@xmldom/xmldom@<0.8.13": ">=0.8.13",
      "@xmldom/xmldom": ">=0.8.13",
      "axios@<1.15.2": ">=1.15.2",
      "drizzle-orm@<0.45.2": ">=0.45.2",
      "fastify@>=5.3.2 <5.8.5": ">=5.8.5",
      "fast-xml-builder@<1.1.7": ">=1.1.7",
      "fast-uri@<3.1.2": ">=3.1.2",
      "@babel/plugin-transform-modules-systemjs@>=7.12.0 <7.29.4": ">=7.29.4",
      "kysely@>=0.26.0 <0.28.17": ">=0.28.17"
    },
    "auditConfig": {
      "ignoreCves": [
        "GHSA-5xrq-8626-4rwp"
      ]
    }
  }
}
