# Production env baked into the Next.js marketing build.
# These NEXT_PUBLIC_* values are inlined into client bundles at build time,
# so they MUST point at real production hosts.
NEXT_PUBLIC_WEB_APP_URL=https://app.aivolearning.com
NEXT_PUBLIC_API_URL=https://api.aivolearning.com
NEXT_PUBLIC_SITE_URL=https://aivolearning.com
