{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "//": "ADR 0020 §1/§5: exactly three build profiles — development, staging, production. Per-role profiles (e.g. parent-prod, teacher-prod) are prohibited; per-role rollout is gated by @aivo/feature-flags AIVO_ROLE_<ROLE>_ENABLED env vars, not by a second app submission.",
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_AIVO_ENV": "development"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "staging": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_AIVO_ENV": "staging",
        "NPM_CONFIG_NODE_LINKER": "hoisted",
        "NPM_CONFIG_SHAMEFULLY_HOIST": "true"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_AIVO_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
