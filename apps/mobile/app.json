{
  "expo": {
    "name": "AIVO — Learn, Teach, Support",
    "slug": "aivo-learning",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "aivo",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "backgroundColor": "#7C3AED",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "com.artpromedia.aivo",
      "associatedDomains": [
        "applinks:aivo.app",
        "applinks:staging.aivo.app"
      ],
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Aivo uses the microphone so learners can answer homework questions and language activities by speaking instead of typing."
      },
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "backgroundColor": "#7C3AED",
        "resizeMode": "contain"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#7C3AED"
      },
      "package": "com.artpromedia.aivo",
      "resizeableActivity": true,
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "backgroundColor": "#7C3AED",
        "resizeMode": "contain"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "aivo.app",
              "pathPrefix": "/learner"
            },
            {
              "scheme": "https",
              "host": "aivo.app",
              "pathPrefix": "/parent"
            },
            {
              "scheme": "https",
              "host": "aivo.app",
              "pathPrefix": "/teacher"
            },
            {
              "scheme": "https",
              "host": "aivo.app",
              "pathPrefix": "/therapist"
            },
            {
              "scheme": "https",
              "host": "aivo.app",
              "pathPrefix": "/caregiver"
            },
            {
              "scheme": "https",
              "host": "aivo.app",
              "pathPrefix": "/notifications"
            },
            {
              "scheme": "https",
              "host": "aivo.app",
              "pathPrefix": "/messages"
            },
            {
              "scheme": "https",
              "host": "aivo.app",
              "pathPrefix": "/settings"
            },
            {
              "scheme": "https",
              "host": "aivo.app",
              "pathPrefix": "/billing"
            },
            {
              "scheme": "https",
              "host": "aivo.app",
              "pathPrefix": "/role-switch"
            },
            {
              "scheme": "https",
              "host": "staging.aivo.app",
              "pathPrefix": "/learner"
            },
            {
              "scheme": "https",
              "host": "staging.aivo.app",
              "pathPrefix": "/parent"
            },
            {
              "scheme": "https",
              "host": "staging.aivo.app",
              "pathPrefix": "/teacher"
            },
            {
              "scheme": "https",
              "host": "staging.aivo.app",
              "pathPrefix": "/therapist"
            },
            {
              "scheme": "https",
              "host": "staging.aivo.app",
              "pathPrefix": "/caregiver"
            },
            {
              "scheme": "https",
              "host": "staging.aivo.app",
              "pathPrefix": "/notifications"
            },
            {
              "scheme": "https",
              "host": "staging.aivo.app",
              "pathPrefix": "/messages"
            },
            {
              "scheme": "https",
              "host": "staging.aivo.app",
              "pathPrefix": "/settings"
            },
            {
              "scheme": "https",
              "host": "staging.aivo.app",
              "pathPrefix": "/billing"
            },
            {
              "scheme": "https",
              "host": "staging.aivo.app",
              "pathPrefix": "/role-switch"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon.png",
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "backgroundColor": "#7C3AED",
        "resizeMode": "contain"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#7C3AED",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AIVO to access your camera for homework capture and IEP uploads."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#7C3AED"
        }
      ],
      "./plugins/withAndroidNativeBuildFixes.js",
      [
        "@sentry/react-native/expo",
        {
          "project": "aivo-mobile"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0354260e-2cdf-4290-b00d-3847ef9513ba"
      }
    },
    "owner": "iamofemeofem"
  }
}
