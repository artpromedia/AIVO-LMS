# AIVO Learning v2 — environment template
# Copy to .env.local for development. All required vars must be set
# in production; lib/env.ts will throw at boot if any are missing.

NODE_ENV=development

# --- Core ---
NEXT_PUBLIC_APP_URL=http://localhost:5000

# --- Database ---
# Required in production. Postgres connection string. Backs the persistence
# adapter (web_* tables via Drizzle) whenever a domain resolves to "postgres";
# lib/env.ts forces every domain to "postgres" in production, so a deploy
# without DATABASE_URL fails fast at boot.
#
# Local containerized Postgres (the database every persistence sprint
# validates against — see docs/runbooks/persistence-postgres.md):
#   docker compose -f ../../docker-compose.web-v2-db.yml up -d --wait
#   export DATABASE_URL=postgres://aivo:aivo@localhost:5432/aivo_web
#   pnpm --filter @aivo/db run db:migrate
#   pnpm --filter @aivo/web-v2 db:seed:postgres
DATABASE_URL=postgresql://user:password@localhost:5432/aivo_v2

# --- Redis (generation/job state) ---
# Required in production.
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Auth provider: "mock" (dev only) | "clerk" | "authjs" | "custom".
# "custom" wires the login form to services/identity-svc at IDENTITY_SVC_URL.
AUTH_MODE=mock
SESSION_SECRET=replace-me-in-production-with-32-bytes-min
# Base URL of services/identity-svc. Used when AUTH_MODE != mock.
IDENTITY_SVC_URL=http://localhost:3001
# Base URL of services/admin-svc. Admin pages proxy real platform reads here.
ADMIN_SVC_URL=http://localhost:3012

# --- AI ---
# Provider abstraction; only the configured provider's key is required.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Object storage (IEP uploads) ---
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=

# --- Observability ---
LOG_LEVEL=info

# --- Persistence ---
# Global mode: "memory" (default) | "postgres". Per-domain overrides (zod-
# validated in lib/env.ts) win for that domain; in production every domain
# must be "postgres". assessments and brainProfiles MUST share a mode (a
# divergence now fails fast at getPersistence() — see index.ts).
# Cutover, rollback, and parity-verification steps: see
# docs/runbooks/persistence-postgres.md. CI proves memory == postgres via the
# Testcontainers parity harness (.github/workflows/web-v2-persistence.yml).
# AIVO_PERSISTENCE=memory
#
# Sprint 1 — STAGING DEFAULTS. The 12 originally-migrated domains are
# parity-proven on Postgres; staging runs them durably. Set DATABASE_URL and
# uncomment to flip staging to postgres (production forces postgres regardless).
# AIVO_PERSISTENCE=postgres
# AIVO_PERSISTENCE_NOTIFICATIONS=postgres
# AIVO_PERSISTENCE_AUDIT=postgres
# AIVO_PERSISTENCE_IDENTITY=postgres
# AIVO_PERSISTENCE_LEARNERS=postgres
# AIVO_PERSISTENCE_ASSESSMENTS=postgres
# AIVO_PERSISTENCE_LESSON_RUNS=postgres
# AIVO_PERSISTENCE_BRAIN_PROFILES=postgres
# AIVO_PERSISTENCE_CURRICULUM=postgres
# AIVO_PERSISTENCE_COMPLIANCE=postgres
# Sprint 5: AIVO_PERSISTENCE_COMPLIANCE also covers the privacy/DSAR/terms
# extension (consent versions, terms, data inventory/retention, disclosure
# logs, DSAR export/deletion requests, IEP-doc access logs).
# AIVO_PERSISTENCE_QUESTS=postgres
# AIVO_PERSISTENCE_ADMIN=postgres
# Sprint 2: web-owned billing/AI-cost/coupon/batch rows (web_* tables).
# Canonical subscription/invoice/seat state stays in billing-svc (ADR 0015).
# AIVO_PERSISTENCE_BILLING=postgres
AIVO_PERSISTENCE_BILLING=
# Sprint 3: web-owned IEP AI-draft review inbox (web_iep_ai_drafts). Canonical
# IEP goals / therapist notes / caregiver observations stay in family-svc
# (ADR 0015, lib/clinical/family-svc-client.ts).
# AIVO_PERSISTENCE_CLINICAL=postgres
AIVO_PERSISTENCE_CLINICAL=
# Sprint 4: platform-global security / SOC 2 / incident / vendor / privacy-
# matrix / vulnerability compliance artifacts (web_* tables, no tenant/RLS).
# AIVO_PERSISTENCE_SECURITY=postgres
AIVO_PERSISTENCE_SECURITY=
# Sprint 6: web-owned rostering / SIS / lesson-sync aggregates. Canonical SIS
# sync (integrations-svc) + teacher-rostering grant (identity-svc) read via REST.
# AIVO_PERSISTENCE_ROSTERING=postgres
AIVO_PERSISTENCE_ROSTERING=
# Sprint 7: web-owned TTS/audio/read-aloud + safety/moderation (web_* tables).
AIVO_PERSISTENCE_AUDIO=
AIVO_PERSISTENCE_SAFETY=
# Sprint 8: web-owned support tickets/AI-jobs + tenant/platform settings.
AIVO_PERSISTENCE_SUPPORT=
AIVO_PERSISTENCE_SETTINGS=
# Sprint 4: collaborator insights + members domain (brain-build inputs).
AIVO_PERSISTENCE_COLLABORATION=

# --- Feature flags ---
# Read directly via process.env in lib/feature-flags.ts (truthy: 1/true/yes/on).
# Sprint 3: gate the "Invite your child's team" onboarding step that sits
# between the parent-assessment submit and the IEP/baseline branch.
# Default OFF in production until QA; ON in dev/preview/test.
AIVO_FLAG_COLLAB_INVITE_STEP=
# Sprint 5: route a completed baseline with no cloned brain profile to an
# actionable brain_build_pending surface instead of silently skipping the
# visual build. Default OFF in production until QA; ON in dev/preview/test.
AIVO_FLAG_VISUAL_BRAIN_BUILD=
