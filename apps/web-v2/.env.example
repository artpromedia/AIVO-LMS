# AIVO Learning v2 — environment template
# Copy to .env.local for development. All required vars must be set
# in production; lib/env.ts will throw at boot if any are missing.

NODE_ENV=development

# --- Core ---
NEXT_PUBLIC_APP_URL=http://localhost:5000

# --- Database ---
# Required in production. Postgres connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/aivo_v2

# --- Redis (generation/job state) ---
# Required in production.
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Mock-mode toggle. When "1", local mock auth is used.
AUTH_MODE=mock
SESSION_SECRET=replace-me-in-production-with-32-bytes-min

# --- AI ---
# Provider abstraction; only the configured provider's key is required.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Object storage (IEP uploads) ---
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=

# --- Observability ---
LOG_LEVEL=info
