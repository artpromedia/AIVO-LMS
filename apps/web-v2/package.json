{
  "name": "@aivo/web-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:brand": "corepack pnpm --filter @aivo/brand run build",
    "check:brand": "node ./scripts/check-brand-tokens.mjs",
    "dev": "corepack pnpm run build:brand && next dev --port 5000 --hostname 0.0.0.0 --turbopack",
    "build": "corepack pnpm run build:brand && next build",
    "start": "corepack pnpm run build:brand && next start --port 5000 --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose -f ../../docker-compose.web-v2-db.yml up -d --wait",
    "db:migrate": "pnpm --filter @aivo/db run db:migrate",
    "db:seed:postgres": "tsx scripts/seed-postgres.ts",
    "test": "vitest run --coverage",
    "test:persistence": "vitest run lib/db/persistence",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y"
  },
  "dependencies": {
    "@aivo/aac-bridge": "workspace:*",
    "@aivo/accessibility-contract": "workspace:*",
    "@aivo/adaptive-baseline": "workspace:*",
    "@aivo/admin-api": "workspace:*",
    "@aivo/admin-auth": "workspace:*",
    "@aivo/api-client": "workspace:*",
    "@aivo/brand": "workspace:*",
    "@aivo/content-pack": "workspace:*",
    "@aivo/db": "workspace:*",
    "@aivo/feature-flags": "workspace:*",
    "@aivo/learner-import": "workspace:*",
    "@aivo/learner-surfaces": "workspace:*",
    "@aivo/nav": "workspace:*",
    "@aivo/observability": "workspace:*",
    "@aivo/ops-alerts": "workspace:*",
    "@aivo/scoring": "workspace:*",
    "@aivo/security": "workspace:*",
    "@aivo/skill-graphs": "workspace:*",
    "@aivo/stage-runtime": "workspace:*",
    "@aivo/stage-ui": "workspace:*",
    "@aivo/ui": "workspace:*",
    "@anthropic-ai/sdk": "^0.100.1",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@sentry/nextjs": "^10.57.0",
    "@tanstack/react-query": "^5.62.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "katex": "^0.16.22",
    "lucide-react": "^0.513.0",
    "next": "^15.5.18",
    "next-intl": "^4.9.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "pixi.js": "^8.18.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@testcontainers/postgresql": "^10.13.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-playwright": "^2.1.0",
    "jsdom": "^25.0.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.1.8",
    "testcontainers": "^10.13.0",
    "typescript": "^5.7.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.8"
  }
}
