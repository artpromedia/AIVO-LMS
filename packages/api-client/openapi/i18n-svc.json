{
  "openapi": "3.0.3",
  "info": {
    "title": "AIVO Internationalization Service",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/api/i18n/health": {
      "get": {
        "operationId": "i18nHealth",
        "summary": "Service health probe",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "service",
                    "timestamp"
                  ],
                  "additionalProperties": true,
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "service": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/i18n/locales": {
      "get": {
        "operationId": "listLocales",
        "summary": "List supported locales and human-readable names",
        "tags": [
          "I18n"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "locales",
                    "default",
                    "available"
                  ],
                  "additionalProperties": true,
                  "properties": {
                    "locales": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "default": {
                      "type": "string"
                    },
                    "available": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "serverTranslations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "note": {
                      "type": "string"
                    },
                    "names": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/i18n/translations/{locale}": {
      "get": {
        "operationId": "getTranslations",
        "summary": "Get all translation keys for a locale",
        "tags": [
          "I18n"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "locale",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "locale",
                    "translations",
                    "fallback"
                  ],
                  "additionalProperties": true,
                  "properties": {
                    "locale": {
                      "type": "string"
                    },
                    "translations": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "fallback": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "supported": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/i18n/translations/{locale}/{namespace}": {
      "get": {
        "operationId": "getNamespaceTranslations",
        "summary": "Get translations scoped to a specific namespace",
        "tags": [
          "I18n"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "locale",
            "required": true
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "namespace",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "locale",
                    "namespace",
                    "translations"
                  ],
                  "additionalProperties": true,
                  "properties": {
                    "locale": {
                      "type": "string"
                    },
                    "namespace": {
                      "type": "string"
                    },
                    "translations": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/i18n/detect": {
      "get": {
        "operationId": "detectLocale",
        "summary": "Detect best-matching locale from the Accept-Language header",
        "tags": [
          "I18n"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detected",
                    "confidence",
                    "source"
                  ],
                  "additionalProperties": true,
                  "properties": {
                    "detected": {
                      "type": "string"
                    },
                    "confidence": {
                      "type": "number"
                    },
                    "source": {
                      "type": "string"
                    },
                    "alternatives": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true,
                        "properties": {
                          "locale": {
                            "type": "string"
                          },
                          "confidence": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/i18n/content/{contentId}/{locale}": {
      "get": {
        "operationId": "getLocalizedContent",
        "summary": "Look up a localized content payload for a given content id",
        "tags": [
          "I18n"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "contentId",
            "required": true
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "locale",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "contentId",
                    "locale",
                    "status"
                  ],
                  "additionalProperties": true,
                  "properties": {
                    "contentId": {
                      "type": "string"
                    },
                    "locale": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "content": {
                      "type": [
                        "null",
                        "object"
                      ],
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:3011"
    }
  ]
}
