    "/api/learning/path/{learnerId}/{subject}/init": {
      "post": {
        "operationId": "initLearningPath",
        "summary": "Initialize a subject learning path",
        "tags": [
          "Learning"
        ],
        "description": "Idempotent: returns the existing path with `status: \"already_exists\"` if one is present, otherwise creates one with default topics and best-effort upgrades to LLM-personalized topics.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "learnerId",
            "required": true
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "subject",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "path"
                  ],
                  "additionalProperties": true,
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "already_exists",
                        "created"
                      ]
                    },
                    "path": {
                      "type": "object",
                      "additionalProperties": true,
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "tenantId": {
                          "type": "string"
                        },
                        "learnerId": {
                          "type": "string"
                        },
                        "subject": {
                          "type": "string"
                        },
                        "topicSequence": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "completedTopics": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "currentTopic": {
                          "type": [
                            "null",
                            "string"
                          ]
                        },
                        "masteryMap": {
                          "type": "object",
                          "additionalProperties": true
                        },
                        "updatedAt": {
                          "type": [
                            "null",
                            "string"
                          ],
                          "format": "date-time"
                        }
                      }
                    },
                    "personalized": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
