                      },
                      "subject": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string"
                      },
                      "contentType": {
                        "type": "string"
                      },
                      "functioningLevel": {
                        "type": [
                          "null",
                          "string"
                        ]
                      },
                      "durationSeconds": {
                        "type": "integer"
                      },
                      "xpEarned": {
                        "type": [
                          "null",
                          "number"
                        ]
                      },
                      "startedAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "completedAt": {
                        "type": [
                          "null",
                          "string"
                        ],
                        "format": "date-time"
                      },
                      "sessionData": {
                        "type": [
                          "null",
