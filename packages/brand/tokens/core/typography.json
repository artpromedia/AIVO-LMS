      "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, monospace",
      "dyslexia": "'Atkinson Hyperlegible', 'OpenDyslexic', 'Inter', ui-sans-serif, system-ui, sans-serif"
    },
    "size": {
