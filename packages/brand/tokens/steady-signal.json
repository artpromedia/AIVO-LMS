          "line": "#FFFFFF",
          "lineStrong": "#FFFFFF",
          "signal": "#E9D5FF",
          "signalHover": "#FFFFFF",
          "signalSoft": "#000000",
          "signalOn": "#000000",
          "beacon": "#FFFF00",
          "beaconSoft": "#000000",
          "positive": "#00FF88",
          "positiveSoft": "#000000",
          "danger": "#FF8080",
          "dangerSoft": "#000000",
          "focus": "#FFFF00"
        }
      },
      "sensory": {
        "calm": {
          "motionScale": 0,
          "soundScale": 0,
          "decorationScale": 0,
          "elevationScale": 0,
          "signalWidth": "4px"
        },
        "standard": {
          "motionScale": 1,
          "soundScale": 0.45,
          "decorationScale": 1,
          "elevationScale": 1,
          "signalWidth": "6px"
        }
      },
      "age": {
        "early": {
          "minTouchTarget": "64px",
          "typeScale": 1.12,
          "gapScale": 1.2,
          "contentDensity": 0.72,
          "contrastTarget": "AAA"
        },
        "middle": {
          "minTouchTarget": "56px",
          "typeScale": 1,
          "gapScale": 1,
          "contentDensity": 1,
