{
  "steadySignal": {
    "$description": "Steady Signal is AIVO's neurodiverse-first design language. This file is the single editable source for web CSS variables and React Native theme resolution. Palette is the calmer, more personal AIVO direction: soft lavender canvas, deep plum ink, and an AIVO violet signal.",
    "foundation": {
      "color": {
        "canvas": "#F7F5FF",
        "surface": "#FFFFFF",
        "surfaceRaised": "#F1ECFE",
        "ink": "#241B3D",
        "inkMuted": "#6A6188",
        "line": "#E5DEF6",
        "lineStrong": "#BBAEE0",
        "signal": "#7C3AED",
        "signalHover": "#6D28D9",
        "signalSoft": "#EDE7FE",
        "signalOn": "#FFFFFF",
        "beacon": "#B45309",
        "beaconSoft": "#FDEBC8",
        "positive": "#15803D",
        "positiveSoft": "#DCFCE7",
        "danger": "#B91C1C",
        "dangerSoft": "#FEE2E2",
        "focus": "#7C3AED"
      },
      "typography": {
        "family": {
          "display": "'Inter', ui-sans-serif, system-ui, sans-serif",
          "body": "'Inter', ui-sans-serif, system-ui, sans-serif",
          "reading": "'Atkinson Hyperlegible', 'Inter', ui-sans-serif, system-ui, sans-serif",
          "mono": "'JetBrains Mono', ui-monospace, monospace"
        },
        "weight": {
          "regular": 400,
          "medium": 500,
          "semibold": 600,
          "bold": 700
        },
        "leading": {
          "display": 1.04,
          "heading": 1.18,
          "body": 1.6,
          "reading": 1.7
        }
      },
      "space": {
        "1": "4px",
        "2": "8px",
        "3": "12px",
        "4": "16px",
        "5": "20px",
        "6": "24px",
        "8": "32px",
        "10": "40px",
        "12": "48px",
        "16": "64px",
        "20": "80px"
      },
      "shape": {
        "control": "12px",
        "surface": "18px",
        "region": "24px",
        "pill": "9999px",
        "notch": "16px",
        "line": "2px"
      },
      "elevation": {
        "rest": "0 1px 2px rgba(60,40,120,0.06), 0 8px 24px rgba(60,40,120,0.08)",
        "raised": "0 2px 4px rgba(60,40,120,0.08), 0 16px 40px rgba(60,40,120,0.12)",
        "focus": "0 0 0 4px rgba(124,58,237,0.28)"
      },
      "motion": {
        "durationInstant": "0ms",
        "durationFast": "120ms",
        "durationBase": "200ms",
        "durationSlow": "360ms",
        "easeStandard": "cubic-bezier(0.2, 0, 0, 1)",
        "easeEnter": "cubic-bezier(0, 0, 0, 1)"
      },
      "layout": {
        "phone": "0px",
        "tabletPortrait": "600px",
        "tabletLandscape": "840px",
        "desktop": "1200px",
        "readingMax": "720px",
        "workspaceMax": "1280px"
      },
      "sound": {
        "confirm": "single-soft-tone",
        "complete": "three-note-rising",
        "attention": "none",
        "ambient": "explicit-opt-in"
      }
    },
    "modes": {
