{
  "name": "@aivo/tutor-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Pure-TS runtime that loads `@aivo/tutor-sdk` definitions, plans sessions over `@aivo/skill-graphs` + `@aivo/content-pack`, and applies `@aivo/pedagogy` strategies + `@aivo/level-transforms` to deliver next-beat decisions (§9.3 Greenfield 4–6w).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@aivo/content-pack": "workspace:*",
    "@aivo/level-transforms": "workspace:*",
    "@aivo/pedagogy": "workspace:*",
    "@aivo/skill-graphs": "workspace:*",
    "@aivo/special-interest-engine": "workspace:*",
    "@aivo/tutor-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.0.0"
  }
}
