{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aivo.dev/schema/curriculum-catalogue.schema.json",
  "title": "Curriculum catalogue authoring records",
  "description": "Cross-language contract for the curriculum-svc authoring/CMS write path (Sprint 4, ADR 0040). curriculum-svc enforces this shape in Python (routes/authoring.py); this file is the canonical, language-neutral definition that the TS authoring tooling and the service stay in sync with.",
  "type": "object",
  "$defs": {
    "district": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "state": { "type": "string", "maxLength": 64 },
        "country": { "type": "string", "minLength": 2, "maxLength": 8 },
        "region": { "type": ["string", "null"], "maxLength": 128 },
        "zipCodes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "skill": {
      "type": "object",
      "required": ["id", "subject", "gradeBand"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 64 },
        "gradeBand": { "type": "string", "minLength": 1, "maxLength": 32 },
        "label": { "type": "string" },
        "summary": { "type": "string" },
        "source": { "type": "string", "description": "Authoritative reference this skill cites." },
        "prerequisites": { "type": "array", "items": { "type": "string" } }
      }
    },
    "contentPack": {
      "type": "object",
      "required": ["id", "title", "subject", "gradeBand"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 64 },
        "gradeBand": { "type": "string", "minLength": 1, "maxLength": 32 },
        "frameworkCode": { "type": "string", "maxLength": 64 },
        "districtIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Each id must reference an existing curriculum_jurisdictions row."
        },
        "skillIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Each id must reference an existing curriculum_skills row."
        }
      }
    }
  }
}
