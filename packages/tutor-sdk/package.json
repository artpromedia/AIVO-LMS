{
  "name": "@aivo/tutor-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Public SDK for declaring AIVO tutors. A `TutorDefinition` describes a tutor's persona, capabilities, supported skill graphs, and policy gates. Consumed by tutor-runtime to schedule sessions (§9.3 Greenfield 4–6w).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@aivo/skill-graphs": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  }
}
