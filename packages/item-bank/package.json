{
  "name": "@aivo/item-bank",
  "version": "0.1.0",
  "private": true,
  "description": "Assessment item-bank primitives — versioned items, cohort A/B routing, defect tracking, and the Sprint 2.2 authoring schema/CLI for importing item fixtures (§9.3 Greenfield 6–8w).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./cli": {
      "types": "./dist/cli/import.d.ts",
      "import": "./dist/cli/import.js",
      "default": "./dist/cli/import.js"
    }
  },
  "bin": {
    "item-bank-import": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "fixtures",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "vitest run",
    "item-bank:import": "tsx src/cli/bin.ts",
    "item-bank:validate": "node scripts/validate-production.mjs"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3",
    "vitest": "^2.0.0"
  }
}
