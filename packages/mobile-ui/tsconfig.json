{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@aivo/brand": ["../brand/src"],
      "@aivo/nav": ["../nav/src"]
    }
  },
  "include": ["src", "../brand/src", "../nav/src"]
}
