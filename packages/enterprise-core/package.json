      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "package.json"],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "vitest run"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "fastify": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fastify": "^5.3.3",
    "typescript": "^5.7.3",
    "vitest": "^2.0.0"
  }
