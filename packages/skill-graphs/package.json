{
  "name": "@aivo/skill-graphs",
  "version": "0.1.0",
  "private": true,
  "description": "Static skill-graph storage with CCSS / NGSS-aligned seed data. Replaces brain-svc's on-demand LLM-synthesized curriculum graph (§5 Content infrastructure, v2.1 §9.3 Build).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  }
}
