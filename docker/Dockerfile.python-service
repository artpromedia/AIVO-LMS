# syntax=docker/dockerfile:1
FROM python:3.12-slim AS builder

ARG SERVICE_NAME

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy and install requirements
COPY services/${SERVICE_NAME}/requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# ── Runtime ──────────────────────────────────────────────────────
FROM python:3.12-slim

ARG SERVICE_NAME
ENV SERVICE_NAME=${SERVICE_NAME}
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src
ENV PORT=3000

WORKDIR /app

# Runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# GIT_COMMIT busts the Docker layer cache for the source COPY on every commit.
# Without this, Docker reuses a cached layer keyed only on the COPY's input
# digest — fine in theory, but in practice we've seen images ship missing
# newly-added files (e.g. routes/playground.py) when the source-tree digest
# briefly matched a prior build. Stamping the commit makes the bust explicit.
ARG GIT_COMMIT=unknown
ENV GIT_COMMIT=${GIT_COMMIT}

# Copy service source
COPY services/${SERVICE_NAME}/src/ ./src/

# Generate startup script (convert brain-svc -> brain_svc for Python module)
# Honors $PORT env (defaults to 3000) so deployments can override the listen port.
RUN MODULE_NAME=$(echo "${SERVICE_NAME}" | sed 's/-/_/g') && \
    printf '#!/bin/sh\nexec python -m uvicorn "%s.main:app" --host 0.0.0.0 --port "${PORT:-3000}"\n' "$MODULE_NAME" > /app/start.sh && \
    chmod +x /app/start.sh

# Create non-root user
RUN addgroup --system --gid 1001 appuser && \
    adduser --system --uid 1001 --ingroup appuser appuser && \
    chown -R appuser:appuser /app
USER appuser

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD sh -c 'curl -f http://localhost:${PORT:-3000}/health || exit 1'

CMD ["/app/start.sh"]
