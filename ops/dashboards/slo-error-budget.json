{
  "uid": "aivo-slo-error-budget",
  "title": "AIVO — SLO Compliance & Error Budget",
  "tags": ["aivo", "slo", "error-budget", "burn-rate", "sprint8"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "",
  "time": { "from": "now-30d", "to": "now" },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "label": "Tenant",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(http_requests_total, tenant_id)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(http_requests_total, service)",
        "includeAll": false,
        "multi": false,
        "current": { "text": "status-page-svc", "value": "status-page-svc" },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "slo_target",
        "label": "SLO target",
        "type": "custom",
        "query": "0.99,0.995,0.999",
        "current": { "text": "0.999", "value": "0.999" },
        "options": [
          { "text": "0.99", "value": "0.99", "selected": false },
          { "text": "0.995", "value": "0.995", "selected": false },
          { "text": "0.999", "value": "0.999", "selected": true }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Observed SLI vs target (availability)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0.95, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{service=~\"$service\", tenant_id=~\"$tenant_id\", status!~\"5..\"}[30m])) / sum(rate(http_requests_total{service=~\"$service\", tenant_id=~\"$tenant_id\"}[30m]))",
          "legendFormat": "observed SLI"
        },
        {
          "refId": "B",
          "expr": "vector($slo_target)",
          "legendFormat": "target"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error budget remaining (% of window budget)",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.1 },
              { "color": "green", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - ( (sum(increase(http_requests_total{service=~\"$service\", tenant_id=~\"$tenant_id\", status=~\"5..\"}[30d]))) / (sum(increase(http_requests_total{service=~\"$service\", tenant_id=~\"$tenant_id\"}[30d])) * (1 - $slo_target)) )",
          "legendFormat": "budget remaining"
        }
      ]
    },
    {
      "id": 3,
      "title": "Burn rate — fast (1h) window",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "( sum(rate(http_requests_total{service=~\"$service\", tenant_id=~\"$tenant_id\", status=~\"5..\"}[1h])) / sum(rate(http_requests_total{service=~\"$service\", tenant_id=~\"$tenant_id\"}[1h])) ) / (1 - $slo_target)",
          "legendFormat": "burn (1h)"
        }
      ]
    },
    {
      "id": 4,
      "title": "Burn rate — slow (6h) window",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "( sum(rate(http_requests_total{service=~\"$service\", tenant_id=~\"$tenant_id\", status=~\"5..\"}[6h])) / sum(rate(http_requests_total{service=~\"$service\", tenant_id=~\"$tenant_id\"}[6h])) ) / (1 - $slo_target)",
          "legendFormat": "burn (6h)"
        }
      ]
    },
    {
      "id": 5,
      "title": "Multi-window page condition (fast AND slow >= threshold)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "OK", "color": "green" },
                "1": { "text": "PAGE", "color": "red" }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "( ( ( sum(rate(http_requests_total{service=~\"$service\", tenant_id=~\"$tenant_id\", status=~\"5..\"}[1h])) / sum(rate(http_requests_total{service=~\"$service\", tenant_id=~\"$tenant_id\"}[1h])) ) / (1 - $slo_target) >= bool 6 ) and ( ( sum(rate(http_requests_total{service=~\"$service\", tenant_id=~\"$tenant_id\", status=~\"5..\"}[6h])) / sum(rate(http_requests_total{service=~\"$service\", tenant_id=~\"$tenant_id\"}[6h])) ) / (1 - $slo_target) >= bool 6 ) )",
          "legendFormat": "page?"
        }
      ]
    }
  ]
}
