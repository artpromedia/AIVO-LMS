{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "storybook:build": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "OPS_ALERT_WEBHOOK_URL"]
    },
    "test:integration": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "env": ["DATABASE_URL", "TEST_DATABASE_URL", "JWT_PRIVATE_KEY", "JWT_PUBLIC_KEY"]
    }
  }
}
