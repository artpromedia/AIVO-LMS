{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "NODE_ENV",
        "PORT",
        "JWT_SECRET",
        "SURFACE_COOKIE_SECRET",
        "COOKIE_SECRET",
        "IDENTITY_SVC_URL",
        "APP_URL",
        "CORS_ORIGINS",
        "NEXT_PUBLIC_WEB_APP_URL",
        "NEXT_PUBLIC_SITE_URL"
      ]
    },
    "storybook:build": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "OPS_ALERT_WEBHOOK_URL"]
    },
    "test:integration": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "env": ["DATABASE_URL", "TEST_DATABASE_URL", "JWT_PRIVATE_KEY", "JWT_PUBLIC_KEY"]
    }
  }
}
